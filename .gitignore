# Android build artifacts
android-benchmark-app/.gradle/
android-benchmark-app/build/
android-benchmark-app/app/build/
android-benchmark-app/local.properties
*.iml
.idea/

# Model binaries (large; hosted externally on Google Drive instead of git --
# unanchored pattern deliberately catches BOTH the top-level /models/
# conversion working directory AND
# android-benchmark-app/app/src/main/assets/models/, since neither is
# tracked in git under this approach).
models/**/*.tflite
models/**/*.onnx
models/**/*.param
models/**/*.bin

# Cloned upstream repos used by conversion scripts (e.g. export_yolox.sh)
conversion/.yolox-src/
conversion/.paddledetection-src/
conversion/.mmdetection-src/
conversion/.mmdeploy-src/
conversion/.nanodet-src/
conversion/rtmdet_work_dir/

# Downloaded checkpoints, archives, and intermediate conversion artifacts --
# all regenerable by re-running the relevant export_*.sh script.
conversion/*.pt
conversion/*.pth
conversion/*.tar
conversion/*.onnx
conversion/*.npy
conversion/sample.jpg
conversion/*_infer/

# Virtualenvs created by conversion scripts (e.g. export_picodet.sh creates
# its own automatically) or by hand per the older scripts' instructions
conversion/*venv*/

# Runtime outputs
results/*/
report/*.html
report/*.csv

# Stray benchmark result JSONs pulled via adb during manual testing (the
# structured results/run_*/ directories above are the real output to keep;
# these are one-off files left wherever a command happened to be run from).
/*.json
android-benchmark-app/*.json
conversion/*.json

# Python
__pycache__/
*.pyc